# Postgres connection string used by the API (psycopg2).
# When running via docker-compose, host must be "db" (the service name).
# For local (non-Docker) dev against the same container, use "localhost".
DATABASE_URL=postgresql://jobtracker:jobtracker_dev_pw@db:5432/job_tracker

# JWT signing secret — generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173
